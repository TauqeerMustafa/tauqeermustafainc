# Base URL of the FastAPI backend (see ../backend).
# No trailing slash, no /api prefix - routes are mounted at the root (e.g. /auth/login, /blog).
#
# Local development: point at your local backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (Vercel): this file does NOT configure the deployed site.
# .env* is gitignored and Vercel builds from git, so it never reads local env files.
# Set NEXT_PUBLIC_API_URL in the Vercel dashboard
# (Project Settings -> Environment Variables -> Production) to the deployed backend URL, e.g.:
#   NEXT_PUBLIC_API_URL=https://tauqeer-inc-backend.onrender.com
# NEXT_PUBLIC_* is inlined at build time, so redeploy after changing it.
# See ../DEPLOYMENT.md for the full runbook.

# ==============================================================================
# Paddle Billing & Checkout Configuration
# ==============================================================================
# Environment: 'sandbox' for testing, 'production' for live payments
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Paddle Client-Side Token (starts with test_ or live_, safe to expose to browser)
# Obtain from: Paddle Dashboard > Developer Tools > Authentication > Client-side tokens
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_client_token_here

# Paddle API Key (server-side only, starts with pdl_sdbx_ or pdl_live_)
# Obtain from: Paddle Dashboard > Developer Tools > Authentication > API Keys
PADDLE_API_KEY=pdl_sdbx_apikey_here

# Paddle Webhook Secret (server-side only, starts with pdl_ntfset_)
# Obtain from: Paddle Dashboard > Developer Tools > Notifications > [Your Destination Secret]
PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_secret_here

