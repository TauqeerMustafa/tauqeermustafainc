# WhatsApp bot (Baileys) — self-hosted service (see ../../WA)
# Local dev points at the local bot service.
WA_SERVICE_URL=http://localhost:3001
# Must match the bot's ADMIN_API_KEY. Leave blank locally (the bot runs open in dev);
# in production set it to the value Render generated for the bot service.
ADMIN_API_KEY=

# Add these to your existing .env.local file
