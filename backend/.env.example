# Copy this file to .env and fill in real values before running the app.

APP_NAME="Tauqeer Inc Backend"
APP_VERSION=0.1.0
ENVIRONMENT=development
APP_DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL connection string (psycopg driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tauqeer_inc

# Used to sign JWT access tokens - generate a long random value for production,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=change-me-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
