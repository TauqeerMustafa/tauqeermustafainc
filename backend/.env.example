# Copy this file to .env and fill in real values before running the app.

APP_NAME="Tauqeer Inc Backend"
APP_VERSION=0.1.0
ENVIRONMENT=development
APP_DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL connection string (psycopg driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tauqeer_inc

# Used to sign JWT access tokens - generate a long random value for production,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=change-me-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days (60 * 24 * 7)

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Production (Render)
# ---------------------------------------------------------------------------
# Do NOT commit a real .env. In production these are real environment variables,
# set for you by the repo-root render.yaml Blueprint (or manually in the Render
# dashboard). Values that differ from local dev:
#
#   ENVIRONMENT=production
#   DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<db>
#       Managed Postgres (Supabase, RDS, ...) requires SSL - the app enables it
#       automatically for non-localhost hosts. Supabase hands you a
#       postgresql://... string; change the scheme to postgresql+psycopg://
#       (psycopg2 is not installed, only psycopg3).
#   SECRET_KEY=<long random value>   # render.yaml generates one automatically
#   CORS_ORIGINS=https://tauqeermustafa.tech,https://www.tauqeermustafa.tech
#
# Full runbook: ../DEPLOYMENT.md

# Client portal verification and OAuth. Set these in Render for production delivery.
CLIENT_PORTAL_URL=http://localhost:3000
VERIFICATION_CODE_TTL_MINUTES=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/client/google/callback
